# Vettr Backend API — Environment Variables
# Copy this file to .env for local development.
# For production, set these in the Koyeb environment variables dashboard.
# Generate JWT_SECRET with: openssl rand -base64 32

# Server
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database
# Local: postgresql://user:password@localhost:5432/vettr
# Production: use DATABASE_URL from Koyeb PostgreSQL dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/vettr

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d

# Stripe — get from https://dashboard.stripe.com/apikeys (test keys for dev, live for production)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Vettr Pro $19.99/mo (test mode) — https://dashboard.stripe.com/test/prices/price_1TYAGb3Afsc66xgUID4LHo4a
STRIPE_MONTHLY_PRICE_ID=price_1TYAGb3Afsc66xgUID4LHo4a

# Email (for notifications) — Gmail: use App Password https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Feedback admin inbox — comma-separated emails that can open /admin/feedback
# FEEDBACK_ADMIN_EMAILS=you@example.com
# Email deep links use WEB_APP_URL (live app). Optional local override for testing only:
# WEB_APP_URL_LOCAL=http://localhost:5173

# Web App URL (for CORS and redirects)
# Local: http://localhost:5173 (Vite dev server) — Production: your Cloudflare Pages URL (e.g. https://your-app.pages.dev)
WEB_APP_URL=https://vettr.pages.dev
# Optional override for invite/accept link host only (defaults to WEB_APP_URL).
# WEB_APP_URL_LOCAL=http://localhost:5173

# Airtable scraper (optional — has default share URL, daily 4am Pacific, and TZ)
# AIRTABLE_SHARE_URL=https://airtable.com/appXXX/shrXXX/tblXXX
# AIRTABLE_SCRAPE_CRON=0 4 * * *
# AIRTABLE_SCRAPE_CRON_TZ=America/Los_Angeles
# AIRTABLE_SCRAPE_ENABLED=true
# AIRTABLE_SCRAPE_ON_STARTUP=true

# External cron (GitHub Actions .github/workflows/airtable-scrape-cron.yml) — set on Koyeb + GitHub secrets
# SCRAPE_TRIGGER_SECRET=generate-with-openssl-rand-base64-32

# Google Calendar + Gmail OAuth (CRM Calendar, Quick IOI send)
# Create OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# Enable APIs: Google Calendar API + Gmail API
# Authorized redirect URI must match API_BASE_URL + /api/crm/calendar/oauth/callback
# GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret

# Off Market BYO LLM keys (AES-256-GCM). Falls back to JWT_SECRET if unset.
# LLM_CREDENTIALS_KEY=generate-with-openssl-rand-base64-32
# NODE_OPTIONS=--max-old-space-size=768

# Stale market listings — set is_active=false when source activity is older than N months (runs right after each Airtable scrape)
# MARKET_DEALS_PRUNE_ENABLED=true
# MARKET_DEALS_MAX_AGE_MONTHS=6

# Web Push (desktop + installed PWA notifications)
# Generate with: node -e "import('web-push').then(w=>console.log(w.generateVAPIDKeys()))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# DIGEST_TZ=America/Los_Angeles
